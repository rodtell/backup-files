{
    "plugins": [
        "typescript",
        "react",
        "react-hooks",
        "jsx-a11y",
        "unicorn",
        "import",
        "node"
    ],
    "env": {
        "browser": true,
        "es2024": true,
        "node": true
    },
    "categories": {
        "correctness": "warn",
        "perf": "warn",
        "suspicious": "warn"
    },
    "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "@typescript-eslint/no-explicit-any": "off",
        "no-useless-constructor": "off",
        "@typescript-eslint/no-useless-constructor": "off",
        "react/react-in-jsx-scope": "off",
        "react/prop-types": "off",
        "import/no-unresolved": "off"
    },
    "ignorePatterns": [
        "dist/**",
        "build/**",
        "out/**",
        ".next/**",
        "node_modules/**",
        "coverage/**"
    ]
}
